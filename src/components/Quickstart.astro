---
const prerequisites = [
  {
    label: "Linux",
    desc: "必须先安装并运行 Docker。CI 在 Ubuntu 26.04/24.04/22.04、Debian 12、Fedora 41、Arch、openSUSE Tumbleweed 等发行版上冒烟测试安装器前置条件。",
  },
  {
    label: "macOS",
    desc: "需要 Apple Silicon（M1+）与 Docker Desktop。llama-server 使用原生 Metal 加速；请把克隆目录放在主文件夹的 ods 路径之外，以免与默认安装目录 ~/ods 冲突。",
  },
  {
    label: "Windows",
    desc: "需要带 WSL2 后端的 Docker Desktop，由安装器代为准备。NVIDIA 机器请先把 Windows 驱动更新到 570 或更高版本；AMD 走 llama.cpp（Vulkan）路径。",
  },
];

const windowsSteps = [
  "检查可用磁盘空间（40 GB）以及硬件虚拟化是否已开启。",
  "提供选项以启用 WSL2，并用 winget 安装 Docker Desktop。Windows 会请求管理员权限，然后重启一次；重新登录后安装会自动继续。",
  "提供选项下载 Ubuntu 24.04，并在 PowerShell 中询问新的 Ubuntu 用户名与密码。",
  "启动 Docker Desktop，并检查它是否已连接到 Ubuntu。若未连接，会提示你开启那一个设置，一旦连通便立即继续。",
  "在 Ubuntu 内以 --pixel --no-hermes 安装 ODS。当 Ubuntu 询问 [sudo] password 时，输入 Ubuntu 密码即可，输入时屏幕上没有任何显示。",
  "验证 Pixel 与 Portal，然后在浏览器中打开 Portal，并向桌面添加一个 ODS Portal 快捷方式。",
];

const bootstrap = [
  ["01", "安装器下载 Qwen3.5 2B（约 1.3 GB）并启动它。"],
  ["02", "核心服务一上线，你就可以开始聊天。"],
  ["03", "适合你硬件的完整模型在后台下载。"],
  ["04", "下载通过校验后，ODS 以完整模型重启模型服务器。"],
];
---

<section id="quickstart" class="relative border-b border-line">
  <div class="mx-auto max-w-350 px-5 py-24 sm:px-8 lg:py-32">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <p class="reveal eyebrow">Quickstart</p>
        <h2
          class="reveal mt-5 font-display text-[clamp(2rem,4.2vw,3.4rem)] font-bold leading-[1.15] tracking-tight"
        >
          选择你的系统，
          <span class="text-amber">复制、粘贴、回车</span>
        </h2>
      </div>
      <a
        href="/#top"
        class="btn-tactile reveal inline-flex items-center gap-2 self-start rounded-full border border-line bg-base-900/60 px-5 py-2.5 text-sm text-muted shadow-sm hover:border-amber/50 hover:text-amber"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="12" y1="19" x2="12" y2="5"></line>
          <polyline points="5 12 12 5 19 12"></polyline>
        </svg>
        <span>回到安装命令</span>
      </a>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h3 class="reveal font-display text-xl font-bold tracking-tight">前置条件</h3>
        <dl class="reveal mt-4 space-y-3">
          {
            prerequisites.map((p) => (
              <div class="panel noise p-5 transition-all duration-200 hover:border-amber/30">
                <dt class="flex items-center gap-2 font-mono text-[13px] tracking-wide text-amber font-semibold">
                  {p.label === "Linux" && (
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12.003 2c-3.138 0-5.467 2.457-5.467 5.753 0 1.25.352 2.398 1.002 3.328-.71.93-1.613 2.053-2.18 3.375-.624 1.455-.858 2.947-.858 4.044 0 1.942 1.34 3.5 3.5 3.5 1.5 0 2.8-.7 3.5-1.5.7.8 2 1.5 3.5 1.5 2.16 0 3.5-1.558 3.5-3.5 0-1.097-.234-2.589-.858-4.044-.567-1.322-1.47-2.445-2.18-3.375.65-.93 1.002-2.078 1.002-3.328C17.47 4.457 15.141 2 12.003 2z"/>
                    </svg>
                  )}
                  {p.label === "macOS" && (
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.4c.66-.82 1.11-1.96.99-3.1-.96.04-2.13.64-2.82 1.45-.61.71-1.14 1.86-1 2.98 1.08.08 2.17-.51 2.83-1.33z"/>
                    </svg>
                  )}
                  {p.label === "Windows" && (
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-13.051-1.8"/>
                    </svg>
                  )}
                  <span>{p.label}</span>
                </dt>
                <dd class="mt-2 text-[14px] leading-[1.85] text-muted">{p.desc}</dd>
              </div>
            ))
          }
        </dl>

        <h3 class="reveal mt-12 font-display text-xl font-bold tracking-tight">引导模式</h3>
        <p class="reveal mt-3 text-[14.5px] leading-[1.9] text-muted">
          ODS 默认使用引导模式，这样你可以在大模型下载完成之前就开始使用。引导模型以 64K
          上下文窗口启动，交换完成后恢复完整模型的上下文目标。跳过引导：<code
            class="rounded bg-base-800 px-1.5 py-0.5 font-mono text-[12.5px] text-amber"
            >./install.sh --no-bootstrap</code
          >
        </p>
        <ol class="reveal mt-6 space-y-3">
          {
            bootstrap.map(([n, text]) => (
              <li class="panel noise flex items-start gap-4 p-4.5 transition-all duration-200 hover:border-amber/30">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-amber/15 font-mono text-[11px] font-bold text-amber">
                  {n}
                </span>
                <p class="text-[14px] leading-[1.85] text-muted">{text}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <div>
        <h3 class="reveal font-display text-xl font-bold tracking-tight">
          Windows 安装器会做什么
        </h3>
        <p class="reveal mt-3 text-[14.5px] leading-[1.9] text-muted">
          每一步在更改任何内容前都会先征求你的同意；若无法完成，会停下来并给出处理说明；修复后重新运行同一条命令即可。
          已有的原生 Windows 安装不会被自动迁移或删除。
        </p>
        <ol class="reveal mt-6 space-y-2">
          {
            windowsSteps.map((step, i) => (
              <li class="panel noise group relative flex items-start gap-4 p-4 transition-all duration-200 hover:border-amber/35 hover:bg-base-800/80">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-line bg-base-950 font-mono text-[11px] font-bold text-faint transition-colors group-hover:text-amber group-hover:border-amber/40">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <p class="text-[13.5px] leading-[1.85] text-muted">{step}</p>
              </li>
            ))
          }
        </ol>

        <div class="reveal mt-8 space-y-4">
          <div class="panel noise p-6">
            <div class="flex items-center gap-2 font-mono text-[11px] tracking-[0.16em] text-amber font-semibold">
              <span class="h-1.5 w-1.5 rounded-full bg-amber" />
              <span>安装后验证</span>
            </div>
            <p class="mt-3 text-[14px] leading-[1.95] text-muted">
              安装器成功完成后，Portal 会在
              <a href="http://localhost:3001/pixel" target="_blank" rel="noopener noreferrer" class="rounded bg-base-800 px-1.5 py-0.5 font-mono text-[12.5px] text-amber hover:underline">
                http://localhost:3001/pixel
              </a>
              打开；<a href="http://localhost:3000" target="_blank" rel="noopener noreferrer" class="rounded bg-base-800 px-1.5 py-0.5 font-mono text-[12.5px] text-amber hover:underline">
                http://localhost:3000
              </a> 是 Open WebUI，一个独立的界面。请验证 Portal 可用并发送一条消息——仅仅是加载出一个控制台，并不代表 Pixel 已就绪。
            </p>
          </div>
          <div class="panel noise p-6">
            <div class="flex items-center gap-2 font-mono text-[11px] tracking-[0.16em] text-amber font-semibold">
              <span class="h-1.5 w-1.5 rounded-full bg-amber" />
              <span>API 端点</span>
            </div>
            <p class="mt-3 text-[14px] leading-[1.95] text-muted">
              Linux 的 Docker 安装默认在
              <code class="rounded bg-base-800 px-1.5 py-0.5 font-mono text-[12.5px] text-ink"
                >localhost:11434</code
              >
              暴露 llama-server，容器内部使用
              <code class="rounded bg-base-800 px-1.5 py-0.5 font-mono text-[12.5px] text-ink"
                >llama-server:8080</code
              >。macOS 原生 Metal 与 Windows 的 AMD 路径使用
              <code class="rounded bg-base-800 px-1.5 py-0.5 font-mono text-[12.5px] text-ink"
                >localhost:8080</code
              >。每个端口都可以通过环境变量配置，例如
              <code class="rounded bg-base-800 px-1.5 py-0.5 font-mono text-[12.5px] text-amber"
                >WEBUI_PORT=9090 ./install.sh</code
              >。
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
