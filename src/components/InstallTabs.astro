---
type Tab = {
  id: string;
  label: string;
  hint: string;
  lang: string;
  code: string;
};

const TABS: Tab[] = [
  {
    id: "unix",
    label: "Linux / macOS",
    hint: "需已安装并运行 Docker。一条命令完成安装、模型选择与服务启动。",
    lang: "bash",
    code: "curl -fsSL https://install.osmantic.com/ods.sh | bash",
  },
  {
    id: "windows",
    label: "Windows",
    hint: "打开普通的 PowerShell 窗口（不要“以管理员身份运行”）。无需预装任何东西，安装器会准备好 WSL2、Ubuntu 与 Docker Desktop，并需要重启一次。",
    lang: "powershell",
    code: `& {
    $ErrorActionPreference = 'Stop'
    $ProgressPreference = 'SilentlyContinue'
    $odsSrc = Join-Path $env:TEMP ('ods-install-' + [guid]::NewGuid().ToString('N'))
    $odsZip = Join-Path $odsSrc 'ods-main.zip'
    New-Item -ItemType Directory -Path $odsSrc | Out-Null
    Invoke-WebRequest -UseBasicParsing 'https://github.com/Osmantic/ODS/archive/refs/heads/main.zip' -OutFile $odsZip
    Expand-Archive -LiteralPath $odsZip -DestinationPath $odsSrc
    $odsEntry = Join-Path $odsSrc 'ODS-main\\install.ps1'
    if (-not (Test-Path -LiteralPath $odsEntry -PathType Leaf)) { throw 'The downloaded archive does not contain the ODS installer.' }
    Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass
    & $odsEntry
}`,
  },
  {
    id: "cloud",
    label: "无 GPU · 云端模式",
    hint: "同样是一整套技术栈，只是用 OpenAI / Anthropic / Together 的 API 代替本地推理。",
    lang: "bash",
    code: "./install.sh --cloud",
  },
  {
    id: "uninstall",
    label: "卸载",
    hint: "Linux、macOS 与 Windows/WSL 安装，从对应的终端执行。",
    lang: "bash",
    code: `# Linux / macOS / Windows(WSL)
cd ~/ods
./ods-uninstall.sh --force

# 仅原生 Windows 安装
cd "$env:USERPROFILE\\ods"
.\\ods.ps1 uninstall --force`,
  },
];
---

<div id="install-tabs-root" class="panel noise overflow-hidden shadow-[0_24px_64px_-24px_rgba(0,0,0,0.7)]">
  <!-- 终端控制窗口栏 -->
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line bg-base-950/80 px-4 py-3 sm:px-5">
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-1.5" aria-hidden="true">
        <span class="h-2.5 w-2.5 rounded-full bg-[#ef4444]/80"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-[#eab308]/80"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-[#22c55e]/80"></span>
      </div>
      <span class="h-3 w-px bg-line" aria-hidden="true"></span>
      <span id="terminal-shell-title" class="font-mono text-[11px] text-faint tracking-wider">
        ods-installer — bash
      </span>
    </div>

    <!-- 标签切换栏 -->
    <div
      role="tablist"
      aria-label="选择安装系统与模式"
      class="flex flex-wrap gap-1 rounded-full border border-line/80 bg-base-900/90 p-1"
    >
      {TABS.map((t, idx) => (
        <button
          type="button"
          role="tab"
          id={`tab-btn-${t.id}`}
          data-tab-id={t.id}
          data-tab-lang={t.lang}
          aria-selected={idx === 0 ? "true" : "false"}
          aria-controls={`tab-panel-${t.id}`}
          class={`tab-trigger btn-tactile rounded-full px-3 py-1 font-mono text-[11px] tracking-wide transition-all duration-150 ${
            idx === 0
              ? "border border-amber/40 bg-amber/15 text-amber shadow-[inset_0_1px_0_rgba(224,162,74,0.3)]"
              : "border border-transparent text-faint hover:text-ink"
          }`}
        >
          {t.label}
        </button>
      ))}
    </div>
  </div>

  <!-- 代码与提示面板列表 -->
  <div class="relative group bg-base-950/60">
    <button
      id="copy-code-btn"
      type="button"
      aria-label="复制安装命令"
      class="btn-tactile absolute right-3.5 top-3.5 z-10 flex items-center gap-1.5 rounded-full border border-line bg-base-800/90 px-3 py-1.5 font-mono text-xs text-muted shadow-[inset_0_1px_0_rgba(255,255,255,0.06)] transition-all duration-200 hover:border-amber/50 hover:text-amber"
    >
      <span id="copy-icon-default" class="flex items-center gap-1.5">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
          <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
        </svg>
        <span>复制</span>
      </span>
      <span id="copy-icon-success" class="hidden items-center gap-1.5 text-moss">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>已复制</span>
      </span>
    </button>

    {TABS.map((t, idx) => {
      const isPowerShell = t.lang === "powershell";
      return (
        <div
          id={`tab-panel-${t.id}`}
          role="tabpanel"
          aria-labelledby={`tab-btn-${t.id}`}
          data-panel-id={t.id}
          data-raw-code={t.code}
          data-shell-label={isPowerShell ? "powershell.exe" : "bash"}
          class={`tab-content-panel ${idx === 0 ? "block" : "hidden"}`}
        >
          <pre class="overflow-x-auto px-5 pb-5 pr-24 pt-4 text-[12.5px] leading-[1.85] sm:text-[13px]">
            <code class="font-mono text-ink/90">
              <span class="select-none font-bold text-amber/80">
                {isPowerShell ? "PS> " : "$ "}
              </span>
              {t.code}
            </code>
          </pre>

          <div
            aria-live="polite"
            class="flex items-start gap-2.5 border-t border-line bg-base-950/40 px-5 py-3 text-[13px] leading-relaxed text-muted"
          >
            <svg
              class="mt-0.5 h-4 w-4 shrink-0 text-amber/80"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12"></line>
              <line x1="12" y2="16" x1="12.01"></line>
            </svg>
            <p>{t.hint}</p>
          </div>
        </div>
      );
    })}
  </div>
</div>

<script>
  function setupInstallTabs() {
    const root = document.getElementById("install-tabs-root");
    if (!root) return;

    const triggers = root.querySelectorAll<HTMLButtonElement>(".tab-trigger");
    const panels = root.querySelectorAll<HTMLElement>(".tab-content-panel");
    const shellTitle = document.getElementById("terminal-shell-title");
    const copyBtn = document.getElementById("copy-code-btn");
    const copyDefault = document.getElementById("copy-icon-default");
    const copySuccess = document.getElementById("copy-icon-success");

    let currentTabId = "unix";

    const activateTab = (tabId: string) => {
      currentTabId = tabId;
      triggers.forEach((btn) => {
        const isMatch = btn.dataset.tabId === tabId;
        btn.setAttribute("aria-selected", String(isMatch));
        if (isMatch) {
          btn.className = "tab-trigger btn-tactile rounded-full px-3 py-1 font-mono text-[11px] tracking-wide transition-all duration-150 border border-amber/40 bg-amber/15 text-amber shadow-[inset_0_1px_0_rgba(224,162,74,0.3)]";
        } else {
          btn.className = "tab-trigger btn-tactile rounded-full px-3 py-1 font-mono text-[11px] tracking-wide transition-all duration-150 border border-transparent text-faint hover:text-ink";
        }
      });

      panels.forEach((p) => {
        const isMatch = p.dataset.panelId === tabId;
        if (isMatch) {
          p.classList.remove("hidden");
          p.classList.add("block");
          if (shellTitle && p.dataset.shellLabel) {
            shellTitle.textContent = `ods-installer — ${p.dataset.shellLabel}`;
          }
        } else {
          p.classList.remove("block");
          p.classList.add("hidden");
        }
      });
    };

    triggers.forEach((btn) => {
      btn.addEventListener("click", () => {
        const tabId = btn.dataset.tabId;
        if (tabId) activateTab(tabId);
      });
    });

    let copyTimer: number | undefined;
    copyBtn?.addEventListener("click", async () => {
      const activePanel = root.querySelector<HTMLElement>(`.tab-content-panel[data-panel-id="${currentTabId}"]`);
      const rawCode = activePanel?.dataset.rawCode;
      if (!rawCode) return;

      try {
        await navigator.clipboard.writeText(rawCode);
        if (copyDefault && copySuccess) {
          copyDefault.classList.add("hidden");
          copySuccess.classList.remove("hidden");
          copySuccess.classList.add("flex");
          copyBtn.classList.add("border-moss/60", "bg-moss/15", "text-moss", "shadow-[0_0_12px_rgba(147,176,118,0.25)]");
          copyBtn.classList.remove("border-line", "bg-base-800/90", "text-muted");
        }

        if (copyTimer) window.clearTimeout(copyTimer);
        copyTimer = window.setTimeout(() => {
          if (copyDefault && copySuccess) {
            copyDefault.classList.remove("hidden");
            copySuccess.classList.add("hidden");
            copySuccess.classList.remove("flex");
            copyBtn.classList.remove("border-moss/60", "bg-moss/15", "text-moss", "shadow-[0_0_12px_rgba(147,176,118,0.25)]");
            copyBtn.classList.add("border-line", "bg-base-800/90", "text-muted");
          }
        }, 2000);
      } catch (err) {
        console.error("Failed to copy code to clipboard", err);
      }
    });
  }

  setupInstallTabs();
  document.addEventListener("astro:page-load", setupInstallTabs);
</script>
