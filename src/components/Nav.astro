---
const LINKS = [
  { href: "/#why", label: "为什么" },
  { href: "/#features", label: "能力" },
  { href: "/#stack", label: "组件" },
  { href: "/#quickstart", label: "快速开始" },
  { href: "/#hardware", label: "硬件" },
  { href: "/#extend", label: "扩展" },
  { href: "/#docs", label: "文档" },
];
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-300 bg-base-950/80 backdrop-blur-md border-b border-line/70"
>
  <nav
    aria-label="主导航"
    class="mx-auto flex h-16 max-w-350 items-center gap-6 px-5 sm:px-8"
  >
    <a href="/" class="group flex items-center gap-2.5">
      <div class="relative flex h-2 w-2">
        <span class="animate-live-ping absolute inline-flex h-full w-full rounded-full bg-moss opacity-75"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-moss"></span>
      </div>
      <span class="font-display text-xl font-bold tracking-tight text-ink transition-colors group-hover:text-amber">
        ODS
      </span>
      <span class="hidden font-mono text-[11px] text-faint tracking-wider transition-colors group-hover:text-muted sm:block">
        Osmantic 部署系统
      </span>
    </a>

    <ul class="ml-auto hidden items-center gap-1.5 lg:flex">
      {LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            class="rounded-full px-3.5 py-1.5 text-[13px] text-muted transition-all duration-150 hover:bg-base-800/70 hover:text-ink active:scale-[0.97]"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <a
      href="https://github.com/Osmantic/ODS"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="在 GitHub 上查看 ODS 仓库"
      class="btn-tactile ml-auto hidden items-center gap-2 rounded-full border border-line bg-base-800/80 px-4 py-1.5 font-mono text-xs text-ink shadow-[inset_0_1px_0_rgba(255,255,255,0.06)] hover:border-amber/50 hover:text-amber lg:ml-0 lg:inline-flex"
    >
      <svg
        class="h-3.5 w-3.5 fill-current"
        viewBox="0 0 16 16"
        aria-hidden="true"
      >
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
      </svg>
      <span>GitHub</span>
    </a>

    <button
      id="mobile-menu-btn"
      type="button"
      aria-label="打开菜单"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="btn-tactile ml-auto flex h-10 w-10 items-center justify-center rounded-full border border-line text-ink hover:border-amber/60 lg:hidden"
    >
      <span class="relative block h-3 w-4">
        <span
          id="hamburger-line-1"
          class="absolute left-0 top-0 h-px w-4 bg-current transition-all duration-300"
        ></span>
        <span
          id="hamburger-line-2"
          class="absolute left-0 top-1.5 h-px w-4 bg-current transition-opacity duration-200"
        ></span>
        <span
          id="hamburger-line-3"
          class="absolute left-0 top-3 h-px w-4 bg-current transition-all duration-300"
        ></span>
      </span>
    </button>
  </nav>

  <div
    id="mobile-menu"
    class="hidden max-h-[calc(100dvh-4rem)] overflow-y-auto border-t border-line bg-base-950/98 backdrop-blur-xl px-5 pb-8 pt-4 lg:hidden"
  >
    <ul class="flex flex-col divide-y divide-line">
      {LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            class="mobile-nav-link flex items-center justify-between py-4 text-base text-muted transition-colors hover:text-ink active:text-amber"
          >
            {link.label}
            <span class="font-mono text-xs text-faint">→</span>
          </a>
        </li>
      ))}
    </ul>
    <a
      href="https://github.com/Osmantic/ODS"
      target="_blank"
      rel="noopener noreferrer"
      class="btn-tactile mt-6 flex w-full items-center justify-center gap-2 rounded-full border border-line bg-base-900/80 px-4 py-3 font-mono text-sm text-amber"
    >
      <svg
        class="h-4 w-4 fill-current"
        viewBox="0 0 16 16"
        aria-hidden="true"
      >
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
      </svg>
      <span>在 GitHub 上查看</span>
    </a>
  </div>
</header>

<script>
  function setupNav() {
    const header = document.getElementById("site-nav");
    if (!header) return;
    // 防止立即执行与 astro:page-load 重复绑定事件监听
    if (header.dataset.navReady === "true") return;
    header.dataset.navReady = "true";

    const menuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const line1 = document.getElementById("hamburger-line-1");
    const line2 = document.getElementById("hamburger-line-2");
    const line3 = document.getElementById("hamburger-line-3");
    const mobileLinks = document.querySelectorAll(".mobile-nav-link");

    let isOpen = false;

    const updateScroll = () => {
      if (!header) return;
      if (window.scrollY > 20 || isOpen) {
        header.classList.add("shadow-[0_4px_24px_-4px_rgba(0,0,0,0.6)]", "bg-base-950/95", "border-line");
        header.classList.remove("bg-base-950/80", "border-line/70");
      } else {
        header.classList.remove("shadow-[0_4px_24px_-4px_rgba(0,0,0,0.6)]", "bg-base-950/95", "border-line");
        header.classList.add("bg-base-950/80", "border-line/70");
      }
    };

    window.addEventListener("scroll", updateScroll, { passive: true });
    updateScroll();

    const toggleMenu = (targetState?: boolean) => {
      isOpen = typeof targetState === "boolean" ? targetState : !isOpen;
      if (!menuBtn || !mobileMenu) return;

      menuBtn.setAttribute("aria-expanded", String(isOpen));
      menuBtn.setAttribute("aria-label", isOpen ? "关闭菜单" : "打开菜单");

      if (isOpen) {
        mobileMenu.classList.remove("hidden");
        document.body.style.overflow = "hidden";
        line1?.classList.add("top-1.5", "rotate-45");
        line1?.classList.remove("top-0");
        line2?.classList.add("opacity-0");
        line2?.classList.remove("opacity-100");
        line3?.classList.add("top-1.5", "-rotate-45");
        line3?.classList.remove("top-3");
      } else {
        mobileMenu.classList.add("hidden");
        document.body.style.overflow = "";
        line1?.classList.remove("top-1.5", "rotate-45");
        line1?.classList.add("top-0");
        line2?.classList.remove("opacity-0");
        line2?.classList.add("opacity-100");
        line3?.classList.remove("top-1.5", "-rotate-45");
        line3?.classList.add("top-3");
      }
      updateScroll();
    };

    menuBtn?.addEventListener("click", () => toggleMenu());
    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => toggleMenu(false));
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) {
        toggleMenu(false);
      }
    });
  }

  // 支持首次加载与 Astro 页面转换
  setupNav();
  document.addEventListener("astro:page-load", setupNav);
</script>
